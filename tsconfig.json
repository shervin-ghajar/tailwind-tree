{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ES2022",
    "module": "ESNext",
    "declaration": false,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "exclude": ["node_modules", "**/dist"],
  "include": [
    "packages/shared/src/**/*.ts",
    "packages/tailwind-tree/src/**/*.ts",
    "packages/extractor/src/**/*.ts",
    "packages/plugin/src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
