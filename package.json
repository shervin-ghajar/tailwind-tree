{
  "name": "tailwind-tree-monorepo",
  "private": true,
  "version": "0.3.0",
  "description": "A utility for writing deeply nested and composable Tailwind CSS classes using an expressive tree structure, supporting responsive and interactive variants for Tailwind v3 and v4.",
  "author": {
    "name": "Shervin Ghajar",
    "email": "ssghajar.work@gmail.com"
  },
  "homepage": "https://github.com/shervin-ghajar/tailwind-tree#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/shervin-ghajar/tailwind-tree.git"
  },
  "license": "MIT",
  "type": "module",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-merge",
    "style",
    "css",
    "utility-first",
    "responsive",
    "design"
  ],
  "scripts": {
    "format": "prettier --write --cache .  --plugin=prettier-plugin-organize-imports",
    "lint": "eslint .",
    "example": "npx tsx ./example/test.ts",
    "build:tailwind-tree": "pnpm --filter tailwind-tree run build",
    "build:extractor": "pnpm --filter @tailwind-tree/extractor run build",
    "build:plugin": "pnpm --filter @tailwind-tree/vite-plugin run build",
    "build:all": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:packages && pnpm size && pnpm test:playgrounds && pnpm build:examples",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc -b packages/exampleV3 packages/exampleV4",
    "build": "pnpm build:tailwind-tree && pnpm build:extractor && pnpm build:plugin",
    "test:packages": "node scripts/check-packages.mjs",
    "size": "node scripts/check-bundles.mjs",
    "dev:v3": "pnpm --filter @tailwind-tree/example-v3 dev",
    "dev:v4": "pnpm --filter @tailwind-tree/example dev",
    "test:playgrounds": "node scripts/check-playgrounds.mjs",
    "build:examples": "pnpm --filter @tailwind-tree/example-v3 build && pnpm --filter @tailwind-tree/example build"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/node": "^22.15.29",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "rollup": "^4.41.1",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.1",
    "tslib": "^2.8.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^4.0.15",
    "@types/babel__traverse": "^7.28.0",
    "postcss": "^8.5.6",
    "tailwind-merge": "^3.7.0",
    "tailwind-merge-v3": "npm:tailwind-merge@2.6.0",
    "tailwindcss-v3-0": "npm:tailwindcss@3.0.24",
    "tailwindcss-v3": "npm:tailwindcss@3.4.17",
    "tailwindcss-v4-0": "npm:tailwindcss@4.0.17",
    "tailwindcss-v4-1": "npm:tailwindcss@4.1.17",
    "tailwindcss-v4": "npm:tailwindcss@4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "vite": "^6.4.1",
    "tailwindcss": "4.3.5",
    "vite-v7": "npm:vite@^7.0.0",
    "vite-v8": "npm:vite@^8.0.0",
    "playwright-core": "^1.58.0"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.19.0"
  }
}
