{
  "name": "tailwind-tree",
  "private": false,
  "version": "0.3.5",
  "description": "A utility for writing deeply nested and composable Tailwind CSS classes using an expressive tree structure, supporting responsive and interactive variants for Tailwind v3 and v4.",
  "author": {
    "name": "Shervin Ghajar",
    "email": "ssghajar.work@gmail.com"
  },
  "homepage": "https://github.com/shervin-ghajar/tailwind-tree#readme",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-merge",
    "style",
    "css",
    "utility-first",
    "responsive",
    "design"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/shervin-ghajar/tailwind-tree.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.mjs"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "format": "prettier --write --cache .  --plugin=prettier-plugin-organize-imports",
    "lint": "eslint ."
  },
  "dependencies": {},
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "tailwind-merge": "^2.6.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "tailwind-merge": {
      "optional": true
    }
  }
}
