{
  "name": "@tailwind-tree/vite-plugin",
  "private": false,
  "version": "0.2.2",
  "description": "Vite integration for statically extracted tailwind-tree candidates with Tailwind CSS v4.",
  "author": {
    "name": "Shervin Ghajar",
    "email": "ssghajar.work@gmail.com"
  },
  "homepage": "https://github.com/shervin-ghajar/tailwind-tree#readme",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-merge",
    "style",
    "css",
    "utility-first",
    "responsive",
    "design",
    "vite",
    "plugin"
  ],
  "main": "dist/index.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/shervin-ghajar/tailwind-tree.git"
  },
  "license": "MIT",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./safelist": "./safelist.css"
  },
  "style": "safelist.css",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "format": "prettier --write --cache .  --plugin=prettier-plugin-organize-imports",
    "lint": "eslint ."
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@babel/traverse": "^7.29.13"
  },
  "devDependencies": {
    "vite": "^6.4.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "safelist.css"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19.0"
  }
}
