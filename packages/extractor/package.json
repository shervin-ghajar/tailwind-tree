{
  "name": "@tailwind-tree/extractor",
  "private": false,
  "version": "0.3.4",
  "description": "A custom extractor enabling tailwind-tree to work seamlessly with Tailwind's JIT engine. See: https://www.npmjs.com/package/tailwind-tree",
  "author": {
    "name": "Shervin Ghajar",
    "email": "ssghajar.work@gmail.com"
  },
  "homepage": "https://github.com/shervin-ghajar/tailwind-tree/tree/main/packages/extractor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shervin-ghajar/tailwind-tree.git",
    "directory": "packages/extractor"
  },
  "keywords": [
    "tailwindcss",
    "tailwind",
    "tailwind-merge",
    "style",
    "css",
    "utility-first",
    "responsive",
    "design"
  ],
  "license": "MIT",
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "format": "prettier --write --cache .  --plugin=prettier-plugin-organize-imports",
    "lint": "eslint ."
  },
  "dependencies": {
    "@babel/parser": "^7.29.13",
    "@babel/traverse": "^7.29.13"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "dist/index.cjs"
}
